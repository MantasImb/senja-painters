meta {
  name: Homepage smoke
  type: http
  seq: 1
  tags: smoke
}

get {
  url: {{baseUrl}}/
  body: none
  auth: none
}

headers {
  accept: text/html
}

tests {
  test("returns a successful HTML response", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.contain("text/html");
  });

  test("renders Senja Malere content", function () {
    expect(res.getBody()).to.contain("Senja Malere");
  });
}
