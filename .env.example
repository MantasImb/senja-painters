# PostgreSQL connection string for Prisma.
# Use a disposable development database locally.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Single admin password for /admin. Must be at least 8 characters.
ADMIN_PASSWORD="replace-with-a-local-admin-password"

# Secret used to sign the HTTP-only admin session cookie.
# Use a random value of at least 32 characters and keep it different from IP_HASH_SECRET.
SESSION_SECRET="replace-with-a-long-random-session-secret"

# Secret used to hash client IP identity for analytics and rate limiting.
# Use a random value of at least 32 characters and keep it different from SESSION_SECRET.
IP_HASH_SECRET="replace-with-a-long-random-ip-hash-secret"

# Public base URL used by metadata and deployment-facing helpers.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
